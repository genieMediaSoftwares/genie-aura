# Backend Environment Variables for GenieAura
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/genieaura_db?schema=public"

# Authentication Secrets
JWT_SECRET="your-super-secure-jwt-secret-key-min-32-chars-change-in-prod"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-super-secure-refresh-jwt-secret-min-32-chars"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS Allowed Origins
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Google Gemini API Key (Backend Server Only)
# Never expose this to client/frontend bundles
GEMINI_API_KEY="AIzaSy..."

# Multi-tenancy default org
DEFAULT_ORG_NAME="Genie Media & Studio"
DEFAULT_ORG_LOCATION="Yendada, Visakhapatnam, India"
